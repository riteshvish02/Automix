// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artifact {
  id          String   @id @default(cuid())
  userId      String
  type        String // "file" | "text" | "json"
  name        String?
  mimeType    String?
  storagePath String?
  textContent String?  @db.Text
  jsonContent Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  password      String
  conversations Conversation[]
  oauthTokens   OAuthToken[]
  artifacts     Artifact[]
  toolMetrics   ToolMetric[]
}

model Conversation {
  id        String                @id @default(cuid())
  userId    String
  title     String?
  summary   String?               @db.Text
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  summaries ConversationSummary[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" | "tool"
  content        String       @db.Text
  toolCallId     String? // OpenAI tool_call_id
  toolName       String? // which tool was called
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  id           String    @id @default(cuid())
  userId       String
  provider     String // "gmail" | "gdrive" | "slack" | "notion" | "calendar"
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model ToolMetric {
  id            String   @id @default(cuid())
  userId        String
  toolName      String
  successCount  Int      @default(0)
  failureCount  Int      @default(0)
  totalDuration Int      @default(0)
  avgDuration   Float    @default(0)
  lastErrorType String?
  lastErrorMsg  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolName])
  @@index([userId, toolName])
}

model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String
  summary        String   @db.Text
  messageCount   Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
