// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowRunStatus {
  planned
  running
  success
  failed
  cancelled
}

enum WorkflowStepType {
  plan
  execute
  validate
  finalize
}

enum WorkflowStepStatus {
  planned
  running
  success
  failed
  skipped
}



model Artifact {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "file" | "text" | "json"
  name        String?
  mimeType    String?
  storagePath String?
  textContent String?  @db.Text
  jsonContent Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  password       String
  conversations  Conversation[]
  oauthTokens    OAuthToken[]
  artifacts      Artifact[]
  workflowRuns   WorkflowRun[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  workflowRuns WorkflowRun[]
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  role           String     // "user" | "assistant" | "tool"
  content        String     @db.Text
  toolCallId     String?    // OpenAI tool_call_id
  toolName       String?    // which tool was called
  createdAt      DateTime   @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // "gmail" | "gdrive" | "slack" | "notion" | "calendar"
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model WorkflowRun {
  id            String            @id @default(cuid())
  userId        String
  conversationId String?
  prompt        String            @db.Text
  status        WorkflowRunStatus @default(planned)
  model         String?
  maxSteps      Int?
  startedAt     DateTime?
  endedAt       DateTime?
  finalAnswer   String?           @db.Text
  errorClass    String?
  errorMessage  String?           @db.Text
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps         WorkflowStep[]
  events        WorkflowEvent[]
  checkpoints   WorkflowCheckpoint[]
  messages      RunMessage[]

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status])
}

model WorkflowStep {
  id            String             @id @default(cuid())
  runId         String
  stepId        String
  stepType      WorkflowStepType
  status        WorkflowStepStatus @default(planned)
  toolName      String?
  input         Json?
  output        Json?
  errorClass    String?
  errorMessage  String?            @db.Text
  retryCount    Int                @default(0)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  run           WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  events        WorkflowEvent[]
  checkpoints   WorkflowCheckpoint[]

  @@unique([runId, stepId])
  @@index([runId, createdAt])
  @@index([status])
}

model WorkflowEvent {
  id             String        @id @default(cuid())
  runId          String
  workflowStepId String?
  eventType      String
  payload        Json?
  createdAt      DateTime      @default(now())

  run            WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step           WorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([workflowStepId])
  @@index([eventType])
}

model WorkflowCheckpoint {
  id             String        @id @default(cuid())
  runId          String
  workflowStepId String?
  sequence       Int
  snapshot       Json
  createdAt      DateTime      @default(now())

  run            WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step           WorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([workflowStepId])
}

model RunMessage {
  id          String      @id @default(cuid())
  runId       String
  role        String
  content     String      @db.Text
  toolName    String?
  toolCallId  String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([role])
}